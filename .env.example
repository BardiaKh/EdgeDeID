# HuggingFace Token Configuration

# For local development:
# - Each developer runs: huggingface-cli login
# - Token is stored in ~/.huggingface/token (NOT in repo)
# - Scripts automatically read from there

# For Colab/Kaggle (shared notebooks):
# - Copy this file to .env
# - Add your personal HF token (from https://huggingface.co/settings/tokens)
# - NEVER commit .env to git (it's in .gitignore)

HF_TOKEN=your_hf_token_here_replace_with_yours
