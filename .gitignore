# Dataset — hosted on HF: EdgeDeID/synthetic-dataset
# Anchored with a leading slash: an unanchored `data/` also matches the
# edgedeid/data/ source package and silently un-tracks it (which dropped the data
# package during the /edgedeid refactor). Anchoring ignores only the top-level
# dataset dir, so no per-directory negation is needed.
/data/
datasets--EdgeDeID--synthetic-dataset/

# Models
/models/

# Run outputs (centralized)
artifacts/

# Generated HF metadata snapshot
hf_collection_info.json

# Generated result spreadsheets (input eval data is committed; see exception below)
evals/**/*.xlsx
# ...but the external eval set itself is input data and ships with the repo.
!evals/ext_eval/revizied_evals.xlsx

# Baseline result CSVs (generated by baselines.ipynb)
evals/baselines/results/

